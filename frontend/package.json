{
  "name": "css-frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "serve": "vite preview --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "type-check:strict": "vue-tsc --noEmit -p tsconfig.strict.json"
  },
  "dependencies": {
    "@github/webauthn-json": "^2.1.1",
    "@headlessui/vue": "^1.7.16",
    "@heroicons/vue": "^2.0.18",
    "axios": "^1.6.2",
    "cytoscape": "^3.33.4",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pinia/testing": "^0.1.7",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^20.10.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.16",
    "daisyui": "^4.4.24",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.32",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.3.6",
    "typescript": "~5.3.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.0.8",
    "vitest": "^4.1.11",
    "vue-tsc": "^1.8.25"
  }
}
