root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.sql]
indent_size = 4

[*.{md,markdown}]
# Two trailing spaces is a hard line break in Markdown, so trimming them
# silently changes rendered output.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
