# Container images the stack battery runs, pinned by digest.
#
# This file and the `[run] images` list in ../.reaper.toml must hold exactly the
# same digests. `run.sh --only preflight` asserts that, and the duplication is
# the point: reaper pre-pulls what its manifest names, and run.sh pulls what
# this file names, so a digest changed in one place and not the other means the
# pre-pull silently stops helping and the run pays a registry round-trip -- or
# worse, runs a different image than the one the manifest claims.
#
# Tags are recorded in comments only. A tag is a moving target, and a run that
# cannot say which bytes it ran is a run whose result stops meaning anything
# tomorrow.

# postgres:18-bookworm
IMG_POSTGRES="docker.io/library/postgres@sha256:1c59e2c3c818eaa0f0628f695b36e7c9e362d6b219b36a54a32df645cbd7e1af"

# eclipse-mosquitto:2
IMG_MOSQUITTO="docker.io/library/eclipse-mosquitto@sha256:6f8d8a947c506f8a2290ec65cd4bd2bc7cb4d43fb5f6271f861cb013e2ef9797"

# debian:bookworm-slim -- runtime base for css-server / css-edge / the webhook
# sink. Bookworm to match the rust:1.97-bookworm builder in .reaper.toml: the
# binaries are linked against that image's glibc and libpq.
IMG_RUNTIME="docker.io/library/debian@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171"

# node:24-bookworm -- runs the .mjs drivers. Matches the development
# workstation's Node 24.18.
IMG_NODE="docker.io/library/node@sha256:4196d66a565c6f195728d9952f161f4adfe2ad753052a08b7ec7f1c5a6bda42b"

# mcr.microsoft.com/playwright:v1.62.1-noble
IMG_PLAYWRIGHT="mcr.microsoft.com/playwright@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e"
